# Token Duel backend — example env config.
# Copy to `.env.local` for local dev (read by dotenv).

# Port for Express server. Railway / Fly inject $PORT at runtime.
PORT=3000

# Base58-encoded 64-byte Ed25519 secret key of the receipt signer.
# Leave unset for local dev — a deterministic DEV keypair derived from
# the seed "token-duel-receipt-signer-devnet-v1" will be used, matching
# the RECEIPT_SIGNER_PUBKEY constant baked into programs/token-duel/src/state.rs.
#
# For prod: generate one with `npm run keygen` and paste here.
# RECEIPT_SIGNER_SECRET=

# Birdeye API key — needed by the physics validator to fetch the same
# price deltas the client saw at game start.
BIRDEYE_API_KEY=your-birdeye-premium-key-here

# Solana RPC URL — backend uses this to look up the Match account for
# player / wager / status cross-checks before signing.
RPC_URL=https://api.devnet.solana.com

# Upper bound on concurrent live sessions. Beyond this, /session/start returns 503.
MAX_CONCURRENT_SESSIONS=500

# Comma-separated CORS allowlist. In dev leave permissive; in prod restrict
# to your Cocos bundle's origin (if any — Android WebView doesn't enforce CORS).
CORS_ORIGINS=*

# ─── Part 11 Bundle B + Part 12 Bundle A: NFT trophies ──────────────────

# Metaplex Bubblegum merkle tree address (created once via `scripts/init-trophy-tree.ts`).
# When set, `tickPayout` mints a cNFT to each of the top-3 weekly winners
# after `pay_season` confirms. Leave empty to disable trophies (SOL payout
# still happens).
# TROPHY_TREE_ADDRESS=

# Public URL of this backend — used in cNFT metadata URIs so Phantom /
# Metaplex can resolve them. Include scheme (http/https) and no trailing slash.
# Defaults to http://localhost:$PORT if unset.
# BACKEND_PUBLIC_URL=https://token-duel-backend.up.railway.app

# ─── Part 12 Bundle B: admin dashboard ──────────────────────────────────

# Optional gate for /admin/stream SSE endpoint. If set, clients must pass
# ?token=<value>. Leave empty to keep dashboard open (demo mode).
# ADMIN_DASHBOARD_TOKEN=

# Optional override for the cron's "public" backend URL when composing
# metadata. Separate knob so we can point admin dashboard + metadata at
# different hostnames during transitions if needed.

# ─── Part 14: tournament host ───────────────────────────────────────────

# Base58-encoded 64-byte Ed25519 secret key for the tournament host.
# Generate via `solana-keygen new --outfile host.json --no-bip39-passphrase`
# then convert: `cat host.json | node -e "const kp=JSON.parse(require('fs').readFileSync(0));console.log(require('bs58').encode(Buffer.from(kp)))"`
# Fund the host pubkey with 0.5 SOL (covers ~500 tournaments @ 0.001 SOL each).
# Run `npm run init-tournament-host` once per cluster to create the host's
# UserStats PDA. Leave unset to disable tournaments entirely.
# TOURNAMENT_HOST_SECRET=

# Set to 'false' to disable the tournament cron without unsetting the secret.
TOURNAMENT_CRON_ENABLED=true

# Milliseconds between tournament seeds. 900_000 = 15 min (devnet default).
# Mainnet: 3_600_000 (1 hr) to concentrate participation per tournament.
# Use 60_000 (1 min) for dev testing — minimum 30s is enforced in code.
TOURNAMENT_CADENCE_MS=900000

# Wager tier index for tournament stakes (0..5). Default 5 = INTRO (0.001 SOL).
# Indexes: 0=0.01, 1=0.05, 2=0.1, 3=0.25, 4=0.5, 5=0.001 (INTRO)
TOURNAMENT_STAKE_TIER=5

# ─── DB Stage 1: Postgres connection ────────────────────────────────────
#
# Postgres connection string — used for users, paper_xp, match_history,
# token_winrates, and notifications tables. Leave unset to run the
# backend without DB features (in-memory fallbacks remain functional).
#
# Local dev (after running scripts/setup-local-db.sh):
#   DATABASE_URL=postgresql://YOUR_USER@localhost:5432/token_duel_dev
#   DB_SSL=false
#
# Render production (paste from Render → Database → Connection):
#   DATABASE_URL=postgresql://user:pass@<host>.render.com/token_duel_db
#   DB_SSL=true
#
# DATABASE_URL=
# DB_SSL=false

# Max concurrent connections to the DB pool. Render Free tier supports ~95;
# Starter ~95. Each active backend replica eats this many.
DB_POOL_MAX=10
